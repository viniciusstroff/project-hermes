# Lido só pelo Docker Compose, para subir o PostgreSQL local de destino
# (docker-compose.postgres.yml). As conexões da migração ficam no .env de cada
# cliente, como SOURCE_<NOME>_* e TARGET_*.
TARGET_DB_NAME=tenant
TARGET_DB_USER=tenant
TARGET_DB_PASS=tenant

# Porta publicada no host. Dentro da rede Docker, o app continua usando target-db:5432.
TARGET_DB_PUBLISHED_PORT=5432

# Versão principal do cliente PostgreSQL instalado na imagem do Hermes (pg_dump),
# só para a cópia nativa. Vazio: sem cliente.
# PG_CLIENT_VERSION=17
