# Conexões do cliente, por nome. Cada origem é um grupo SOURCE_<NOME>_* com
# SOURCE_<NOME>_ADAPTER; o destino é TARGET_ADAPTER e TARGET_*. A migração pede
# a origem pelo nome: self.context.source('v1').
#
#   cp Acme/.env.example Acme/.env

# Origem principal: PostgreSQL da V1
SOURCE_V1_ADAPTER=postgres
SOURCE_V1_HOST=host.docker.internal
SOURCE_V1_PORT=3396
SOURCE_V1_NAME=client-db-v1
SOURCE_V1_USER=user
SOURCE_V1_PASS=pass
# Cópia nativa das entidades compatíveis (opcional, só com destino PostgreSQL).
# SOURCE_V1_NATIVE_COPY=pg_dump
# SOURCE_V1_PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump

# Origem auxiliar: Firebird da V1. Opcional; apague o grupo se o cliente não usa.
SOURCE_FB_ADAPTER=firebird
SOURCE_FB_HOST=host.docker.internal
SOURCE_FB_PORT=3050
SOURCE_FB_NAME=client-firebird-v1
SOURCE_FB_USER=user
SOURCE_FB_PASS=pass
SOURCE_FB_CHARSET=ISO8859_1

# Destino: PostgreSQL da V2 (o target-db do docker-compose.postgres.yml)
TARGET_ADAPTER=postgres
TARGET_HOST=target-db
TARGET_PORT=5432
TARGET_NAME=tenant
TARGET_USER=tenant
TARGET_PASS=tenant
