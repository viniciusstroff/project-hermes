# Contrato generico do banco de destino.
# O codigo atual ainda usa PG_V2_*, mas novos adapters devem partir destes nomes.
TARGET_DB_ADAPTER=postgres
TARGET_DB_HOST=target-db
TARGET_DB_PORT=5432
TARGET_DB_NAME=tenant
TARGET_DB_USER=tenant
TARGET_DB_PASS=tenant

# Porta publicada no host pelo docker-compose.postgres.yml.
# Dentro da rede Docker, o app continua usando target-db:5432.
TARGET_DB_PUBLISHED_PORT=5432

# Conexoes V2 atuais, mantidas por compatibilidade com o core existente.
PG_V2_HOST=target-db
PG_V2_PORT=5432
PG_V2_NAME=tenant
PG_V2_USER=tenant
PG_V2_PASS=tenant

# Conexoes FIREBIRD
FB_V1_HOST=host.docker.internal
FB_V1_PORT=3050
FB_V1_NAME=client-firebird-v1
FB_V1_USER=user
FB_V1_PASS=pass
FB_V1_CHARSET=ISO8859_1

# Conexoes PostgreSQL V1
PG_V1_HOST=host.docker.internal
PG_V1_PORT=3396
PG_V1_NAME=client-db-v1
PG_V1_USER=user
PG_V1_PASS=pass
