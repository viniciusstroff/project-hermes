# Conexões da AcmeEdu, cliente fictício. Valem para o container project-hermes,
# na rede hermes-net. Fora do Docker, use localhost e as portas 5441 e 5442.
#
#   cp AcmeEdu/.env.example AcmeEdu/.env

# PostgreSQL V1 (origem legada)
PG_V1_HOST=acmeedu-v1
PG_V1_PORT=5432
PG_V1_NAME=acmeedu_v1
PG_V1_USER=acmeedu
PG_V1_PASS=acmeedu

# PostgreSQL V2 (destino)
PG_V2_HOST=acmeedu-v2
PG_V2_PORT=5432
PG_V2_NAME=acmeedu_v2
PG_V2_USER=acmeedu
PG_V2_PASS=acmeedu

# A AcmeEdu não usa Firebird. Sem FB_V1_HOST, o Hermes não tenta conectar.
