# Conexões da AcmeEdu, cliente fictício. Valem para o container project-hermes,
# na rede hermes-net. Fora do Docker, use localhost e as portas 5441 e 5442.
#
#   cp AcmeEdu/.env.example AcmeEdu/.env

# Origem: PostgreSQL V1 legado, pedida no script como self.context.source('v1')
SOURCE_V1_ADAPTER=postgres
SOURCE_V1_HOST=acmeedu-v1
SOURCE_V1_PORT=5432
SOURCE_V1_NAME=acmeedu_v1
SOURCE_V1_USER=acmeedu
SOURCE_V1_PASS=acmeedu

# Destino: PostgreSQL V2
TARGET_ADAPTER=postgres
TARGET_HOST=acmeedu-v2
TARGET_PORT=5432
TARGET_NAME=acmeedu_v2
TARGET_USER=acmeedu
TARGET_PASS=acmeedu
